# Environment variables you will need to set for the application
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=

NEXT_PUBLIC_ENCRYPT_KEY=
NEXT_PUBLIC_PLACES_API_LIMIT=

SERVICE_KEY=

API_KEY=
RESEND_API_KEY=

# OpenAI — used by /api/fitness/generate (and /api/fitness/generate-admin)
# to build workout plans. Requires a platform.openai.com API key — this is
# a SEPARATE product/account from a ChatGPT Plus/Business/Enterprise
# subscription, which does not include API access.
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
NEXT_PUBLIC_OPENAI_MODEL=gpt-4o

SUPPORT_TEAM_EMAIL=4ourlife.app@gmail.com

# WhatsApp only (lib/twilio.ts) — plain SMS and OTP verification moved to AWS, see below.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_CONTENT_TEMPLATE_SID=

# SMS (lib/sms.ts) — AWS SNS / End User Messaging. Needs an IAM user/role scoped
# to sms-voice:SendTextMessage, a Ghana long code or Sender ID (SMS_ORIGINATION_ID),
# and an End User Messaging configuration set (SMS_CONFIG_SET) for delivery logging.
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SMS_ORIGINATION_ID=
SMS_CONFIG_SET=

# Required by app/api/period/trivia (lib/period-trivia-security.ts) — without
# these, GET /api/period/trivia returns "Trivia security is not configured".
# Each must be a random string of 32+ chars; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRIVIA_DEVICE_PEPPER=
PERIOD_LEAD_ENCRYPTION_KEY=

# ── Email: AWS SES v2 (lib/email.ts) ─────────────────────────────────────
# Transactional email: admin invites, admin login alerts, and the device
# sign-in OTP. Replaced SendGrid on 5 Sept 2026.
#
# AWS_REGION (set above, currently eu-north-1) is shared with AWS End User
# Messaging SMS. SES only sees identities verified IN THAT REGION, so if the
# sender was verified elsewhere this is the variable to check first — the
# failure is "Email address is not verified", which reads like a verification
# problem rather than a region one.
SES_FROM_EMAIL=life@4ourlife.com
# Optional: a configuration set, for bounce and complaint tracking.
# SES_CONFIGURATION_SET=

# NOTE: a new SES account starts in the sandbox and can only send to VERIFIED
# addresses. Until the account is moved to production access, mail to anyone
# else fails with "MessageRejected: Email address is not verified" — an AWS
# state, not an application bug.
