# Environment variables you will need to set for the application
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=

# This admin app's own public URL, no trailing slash — e.g. https://office.4ourlife.com
# Used to build links this server sends out: admin accept-invite links
# (features/users/api/invite.ts), and the provider invite / /auth/welcome
# link (lib/provider-invite.ts, P0-06).
NEXT_PUBLIC_APP_URL=

NEXT_PUBLIC_ENCRYPT_KEY=
NEXT_PUBLIC_PLACES_API_LIMIT=

SERVICE_KEY=

API_KEY=

# OpenAI — used by /api/fitness/generate (and /api/fitness/generate-admin)
# to build workout plans. Requires a platform.openai.com API key — this is
# a SEPARATE product/account from a ChatGPT Plus/Business/Enterprise
# subscription, which does not include API access.
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
NEXT_PUBLIC_OPENAI_MODEL=gpt-4o

SUPPORT_TEAM_EMAIL=4ourlife.app@gmail.com

# Twilio Verify (phone OTP) and WhatsApp.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_WHATSAPP_NUMBER=
TWILIO_CONTENT_TEMPLATE_SID=

# WhatsApp Utility template for the provider invite (P0-06, lib/provider-invite.ts).
# Blocked on Meta template approval as of PLAN.md — leave unset and
# deliverProviderInvite() skips WhatsApp cleanly, falling through to SMS.
TWILIO_PROVIDER_INVITE_TEMPLATE_SID=

# Plain SMS (lib/aws-sms.ts) — AWS End User Messaging. Needs an IAM user/role scoped
# to sms-voice:SendTextMessage, a Ghana long code or Sender ID (SMS_ORIGINATION_ID),
# and an End User Messaging configuration set (SMS_CONFIG_SET) for delivery logging.
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SMS_ORIGINATION_ID=
SMS_CONFIG_SET=

# Required by app/api/period/trivia (lib/period-trivia-security.ts) — without
# these, GET /api/period/trivia returns "Trivia security is not configured".
# Each must be a random string of 32+ chars; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRIVIA_DEVICE_PEPPER=
PERIOD_LEAD_ENCRYPTION_KEY=

# ── Transactional email: Twilio SendGrid (lib/email.ts) ───────────────────
# Used for support mail, admin invites, admin login alerts, and device sign-in
# OTP. SENDGRID_FROM_EMAIL must belong to a domain authenticated in SendGrid.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=auth@mail.4ourlife.com
SENDGRID_FROM_NAME=4 Our Life

# ── Feature flags: PostHog sync (lib/posthog-admin.ts, P0-07) ─────────────
# PostHog is where flags are actually evaluated (the mobile app reads them
# client-side with a project TOKEN — a different, read-only credential this
# does not use). This is the server-side, write-capable client: Settings →
# Feature Flags pushes toggles here, and /api/settings/feature-flags/sync
# pulls PostHog's state back in case a flag was changed there directly.
# POSTHOG_HOST is the APP/API host (app.posthog.com, or us.posthog.com /
# eu.posthog.com depending on region) — NOT the ingestion host
# (us.i.posthog.com) the mobile app's EXPO_PUBLIC_POSTHOG_HOST points at.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://app.posthog.com

# Shared bearer secret for Vercel Cron-triggered routes (features/reports/api/cron.ts,
# app/api/settings/feature-flags/sync/route.ts). Vercel sends this automatically
# once the env var is set; without it, those routes refuse to run.
CRON_SECRET=
